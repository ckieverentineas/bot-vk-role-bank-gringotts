DATABASE_URL="file:./dev.db"

# VK group token with messages/long poll access.
token="vk_group_token"

# VK user ID of the root administrator.
root="123456789"

# VK peer ID for log messages.
chat_id="2000000001"

# Optional fallback VK group ID used when autodetect by token fails.
group_id="123456789"
